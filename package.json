{
  "name": "engine-specs-app",
  "version": "0.5.2",
  "private": true,
  "description": "Automotive engine & vehicle diagnostic knowledge app (Android, offline, English / Tamil / Sinhala)",
  "scripts": {
    "samples": "node samples/build.js",
    "data": "node tools/validate.js && node tools/build-data.js",
    "test": "node tools/test-app.js",
    "sync": "npx cap sync android",
    "apk:debug": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
